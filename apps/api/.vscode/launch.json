{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug NestJS",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": ["run", "debug"],
            "console": "integratedTerminal",
            "restart": true,
            "sourceMaps": true,
            "cwd": "${workspaceFolder}",
            "skipFiles": ["<node_internals>/**", "node_modules/**"]
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to NestJS",
            "port": 9229,
            "restart": true,
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**", "node_modules/**"]
        }
    ]
}
