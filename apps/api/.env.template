# =====================
# 应用配置 (app.config)
# =====================
APP_PORT=3000
APP_HOST=0.0.0.0
APP_NAME=nest-admin
APP_VERSION=1.0.0
APP_LOG_LEVEL=info
APP_FRONTEND_URL=http://localhost:5173

# 可选：浏览器跨域访问 API 子域名时，填写前端源（逗号分隔多个），如 https://app.example.com
# CORS_ORIGINS=https://app.example.com

# =====================
# 数据库 (database.config)
# =====================
# 不可为 root：官方镜像用 MYSQL_ROOT_PASSWORD 管 root，MYSQL_USER 仅创建普通账号
MYSQL_USER="deploy"
MYSQL_PASSWORD="xxxxx"
MYSQL_ROOT_PASSWORD="xxxxx"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="nest-admin"

# 可选：数据库连接重试
# DB_CONNECT_RETRY_ATTEMPTS=5
# DB_CONNECT_RETRY_DELAY_MS=3000

# =====================
# Redis (redis.config)
# =====================
REDIS_URL=redis://localhost:6379
# 若使用 TLS: rediss://localhost:6379

# =====================
# 认证 (auth.config)
# =====================
AUTH_ACCESS_TOKEN_SECRET=your-access-token-secret-change-in-production
AUTH_ACCESS_TOKEN_EXP=15m
AUTH_REFRESH_TOKEN_TTL=604800
AUTH_MAGIC_LOGIN_TOKEN_TTL=300

# =====================
# 微信小程序 (wechat.config)
# =====================
# 小程序 AppID 与 AppSecret（管理后台「开发管理-开发设置」获取，AppSecret 仅服务端使用，切勿下发前端）
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
# 可选：微信接口服务根地址，默认 https://api.weixin.qq.com，便于测试时指向 mock
# WECHAT_API_BASE_URL=https://api.weixin.qq.com

# =====================
# 邮件 SMTP (email.config)
# =====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# 可选：邮件发送限流
# EMAIL_RATE_LIMIT_MAX=1
# EMAIL_RATE_LIMIT_WINDOW=60
