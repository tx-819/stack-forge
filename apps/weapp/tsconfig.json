{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@stack-forge/contracts": ["../../packages/contracts/src/index.ts"],
      "@stack-forge/contracts/*": ["../../packages/contracts/src/*"],
      "@stack-forge/shared": ["../../packages/shared/src/index.ts"],
      "@stack-forge/shared/*": ["../../packages/shared/src/*"]
    },
    "types": [
      "@dcloudio/types",
      "@mini-types/alipay",
      "miniprogram-api-typings",
      "@uni-helper/uni-types",
      "@wot-ui/ui/global",
      "uni-echarts/global"
    ],
    "sourceMap": true
  },
  "vueCompilerOptions": {
    "plugins": ["@uni-helper/uni-types/volar-plugin"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": ["src/uni_modules"]
}
