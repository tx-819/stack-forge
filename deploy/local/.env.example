# 复制为 deploy/local/.env 后填写（.env 勿提交仓库）。

# 云服务器 SSH
SSH_HOST=47.x.x.x
SSH_USER=ubuntu
# 私钥路径；留空则使用 ssh 默认 identity
SSH_KEY=~/.ssh/stack_forge_deploy

# 服务器部署根目录（其下应有 api/、admin/）
DEPLOY_PATH=/opt/stack-forge

# 构建目标平台（默认 linux/amd64，适配常见云服务器；Apple Silicon 本机也请保持此项）
# DOCKER_PLATFORM=linux/amd64

# admin 容器内 nginx 反代后端（首次部署或变更时写入服务器 .env）
BACKEND_UPSTREAM=http://nest-admin:3000
