{
  "name": "template-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:server": "pnpm --filter api dev",
    "dev:web": "pnpm --filter admin dev",
    "start:server": "pnpm --filter api start",
    "build:server": "pnpm --filter api build",
    "build:web": "pnpm --filter admin build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@scarf/scarf",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "unrs-resolver"
    ]
  }
}
